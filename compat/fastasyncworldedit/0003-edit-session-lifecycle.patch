+package com.sk89q.worldedit.event.extent;
+
+import com.sk89q.worldedit.EditSession;
+import org.junit.jupiter.api.Test;
+
+import java.util.concurrent.atomic.AtomicInteger;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+
+class EditSessionLifecycleTest {
+    @Test
+    void clonedStagesShareExactlyOneSessionClosure() {
+        EditSessionEvent original = new EditSessionEvent(null, null, -1, null);
+        EditSessionEvent before = original.clone(EditSession.Stage.BEFORE_CHANGE);
+        EditSessionEvent after = original.clone(EditSession.Stage.BEFORE_HISTORY);
+        AtomicInteger closed = new AtomicInteger();
+        before.onSessionClose(closed::incrementAndGet);
+        after.onSessionClose(closed::incrementAndGet);
+        original.completeSession();
+        before.completeSession();
+        after.completeSession();
+        assertEquals(2, closed.get());
+        assertThrows(IllegalStateException.class, () -> original.onSessionClose(closed::incrementAndGet));
+    }
+}
