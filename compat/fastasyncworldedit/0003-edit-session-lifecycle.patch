+package com.sk89q.worldedit;
+
+import com.fastasyncworldedit.core.limit.FaweLimit;
+import com.fastasyncworldedit.core.extent.processor.lighting.Relighter;
+import com.sk89q.worldedit.function.operation.Operation;
+import com.sk89q.worldedit.event.extent.EditSessionEvent;
+import com.sk89q.worldedit.world.World;
+import org.junit.jupiter.api.Test;
+
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.concurrent.locks.ReentrantLock;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertSame;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.mockito.Mockito.doCallRealMethod;
+import static org.mockito.Mockito.doAnswer;
+import static org.mockito.ArgumentMatchers.anyBoolean;
+import static org.mockito.Mockito.doThrow;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.spy;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+
+class SessionFailureCompletionTest {
+    @Test
+    void failedFlushStillClosesTheSessionAndPreservesBothFailures() {
+        EditSessionBuilder builder = mock(EditSessionBuilder.class);
+        World world = mock(World.class);
+        when(builder.compile()).thenReturn(builder);
+        when(builder.getExtent()).thenReturn(world);
+        when(builder.getWorld()).thenReturn(world);
+        when(builder.getLimit()).thenReturn(new FaweLimit());
+        when(builder.isWNAMode()).thenReturn(true);
+        EditSession session = spy(new EditSession(builder));
+        IllegalStateException flushFailure = new IllegalStateException("flush failed");
+        IllegalArgumentException closureFailure = new IllegalArgumentException("close callback failed");
+        doThrow(flushFailure).when(session).flushQueue();
+        doThrow(closureFailure).when(builder).completeSession();
+        assertSame(flushFailure, assertThrows(IllegalStateException.class, session::close));
+        assertEquals(1, flushFailure.getSuppressed().length);
+        assertSame(closureFailure, flushFailure.getSuppressed()[0]);
+        verify(builder).completeSession();
+    }
+
+    @Test
+    void closesOnlyAfterDrainingRelightGeneratedQueueWrites() {
+        EditSessionBuilder builder = mock(EditSessionBuilder.class);
+        World world = mock(World.class);
+        Relighter relighter = mock(Relighter.class);
+        when(builder.compile()).thenReturn(builder);
+        when(builder.getExtent()).thenReturn(world);
+        when(builder.getWorld()).thenReturn(world);
+        when(builder.getLimit()).thenReturn(new FaweLimit());
+        when(builder.isWNAMode()).thenReturn(false);
+        when(builder.getRelighter()).thenReturn(relighter);
+        when(relighter.getLock()).thenReturn(new ReentrantLock());
+        AtomicInteger commits = new AtomicInteger();
+        AtomicInteger lighting = new AtomicInteger();
+        doAnswer(invocation -> { lighting.incrementAndGet(); return null; })
+                .when(relighter).fixLightingSafe(anyBoolean());
+        doAnswer(invocation -> { lighting.incrementAndGet(); return null; })
+                .when(relighter).removeAndRelight(anyBoolean());
+        EditSession session = spy(new EditSession(builder));
+        Operation operation = mock(Operation.class);
+        doAnswer(invocation -> {
+            if (commits.incrementAndGet() == 2) {
+                assertEquals(1, lighting.get());
+            }
+            return operation;
+        }).when(session).commit();
+        doAnswer(invocation -> { assertEquals(2, commits.get()); return null; })
+                .when(builder).completeSession();
+        session.close();
+        assertEquals(2, commits.get());
+        verify(builder).completeSession();
+    }
+
+    @Test
+    void failedConstructionPreservesItsFailureWhenClosureAlsoFails() {
+        EditSessionBuilder builder = mock(EditSessionBuilder.class);
+        IllegalStateException constructionFailure = new IllegalStateException("construction failed");
+        IllegalArgumentException closureFailure = new IllegalArgumentException("close callback failed");
+        when(builder.compile()).thenThrow(constructionFailure);
+        doThrow(closureFailure).when(builder).completeSession();
+        doCallRealMethod().when(builder).build();
+        assertSame(constructionFailure, assertThrows(IllegalStateException.class, builder::build));
+        assertEquals(1, constructionFailure.getSuppressed().length);
+        assertSame(closureFailure, constructionFailure.getSuppressed()[0]);
+    }
+
+    @Test
+    void failedCallbackDoesNotLeaveLaterSessionsAdmitted() {
+        EditSessionEvent event = new EditSessionEvent(null, null, -1, null);
+        AtomicInteger closed = new AtomicInteger();
+        IllegalStateException firstFailure = new IllegalStateException("first callback failed");
+        AssertionError lastFailure = new AssertionError("last callback failed");
+        event.onSessionClose(() -> { throw firstFailure; });
+        event.onSessionClose(closed::incrementAndGet);
+        event.onSessionClose(() -> { throw lastFailure; });
+        assertSame(firstFailure, assertThrows(IllegalStateException.class, event::completeSession));
+        assertEquals(1, closed.get());
+        assertSame(lastFailure, firstFailure.getSuppressed()[0]);
+        event.completeSession();
+        assertEquals(1, closed.get());
+    }
+}
