+    private static final class Fixture {
+        private final IQueueExtent<IQueueChunk> owner = mock(IQueueExtent.class);
+        private final IChunkGet get = mock(IChunkGet.class);
+        private final IChunkSet set = mock(IChunkSet.class);
+        private final BatchProcessorHolder preprocessing = new BatchProcessorHolder();
+        private final BatchProcessorHolder outer = new BatchProcessorHolder();
+        private final BatchProcessorHolder inner = new BatchProcessorHolder();
+        private final AtomicInteger block = new AtomicInteger();
+        private final Observer observer = new Observer(block);
+        private final AtomicReference<Runnable> finalizer = new AtomicReference<>();
+        private final ChunkHolder<?> chunk = ChunkHolder.newInstance();
+        private final ParallelQueueExtent parallel;
+
+        private Fixture() {
+            inner.setPostProcessor(observer);
+            outer.setPostProcessor(inner);
+            when(owner.cancel()).thenReturn(true);
+            when(owner.getProcessor()).thenReturn(preprocessing);
+            when(owner.getPostProcessor()).thenReturn(outer);
+            when(owner.getCachedGet(-3, 8)).thenReturn(get);
+            when(owner.processSet(any(), any(), any())).thenAnswer(invocation -> preprocessing.processSet(
+                    invocation.getArgument(0), invocation.getArgument(1), invocation.getArgument(2)));
+            when(get.setCreateCopy(anyBoolean())).thenReturn(7);
+            doAnswer(invocation -> {
+                block.set(1);
+                finalizer.set(invocation.getArgument(2));
+                return null;
+            }).when(get).call(any(), any(), any());
+            QueueHandler handler = mock(QueueHandler.class);
+            World world = mock(World.class);
+            when(handler.getQueue(any(), any(), any())).thenReturn(owner);
+            parallel = new ParallelQueueExtent(handler, world, true, null);
+            chunk.init(owner, -3, 8);
+        }
+    }
+
+    private static final class Observer implements IBatchProcessor {
+        private final AtomicInteger block;
+        private RuntimeException failure;
+        private final AtomicInteger notifications = new AtomicInteger();
+        private final AtomicInteger completed = new AtomicInteger();
+        private final AtomicReference<IChunkSet> appliedSet = new AtomicReference<>();
+
+        private Observer(AtomicInteger block) {
+            this.block = block;
+        }
+
+        @Override
+        public IChunkSet processSet(IChunk chunk, IChunkGet get, IChunkSet set) {
+            return set;
+        }
+
+        @Override
+        public void postProcess(IChunk chunk, IChunkGet get, IChunkSet set) {
+            assertEquals(1, block.get());
+            appliedSet.set(set);
+            notifications.incrementAndGet();
+            if (failure != null) {
+                throw failure;
+            }
+        }
+
+        @Override
+        public boolean requiresBeforeState() {
+            return false;
+        }
+
+        @Override
+        public void applicationCompleted() {
+            completed.incrementAndGet();
+        }
+
+        @Override
+        public Extent construct(Extent child) {
+            return child;
+        }
+
+        @Override
+        public ProcessorScope getScope() {
+            return ProcessorScope.READING_BLOCKS;
+        }
+    }
