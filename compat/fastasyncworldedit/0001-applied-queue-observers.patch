+@SuppressWarnings("rawtypes")
+class AppliedChunkCompletionTest {
+    @Test
+    void realParallelCancellationPreservesAppliedObserverThroughNestedMutableHolders() throws Exception {
+        Fixture fixture = new Fixture();
+        CountDownLatch finalizerReady = new CountDownLatch(1);
+        CountDownLatch releaseFinalizer = new CountDownLatch(1);
+        ExecutorService executor = Executors.newSingleThreadExecutor();
+        try {
+            fixture.chunk.call(fixture.owner, fixture.set, () -> { });
+            assertEquals(1, fixture.block.get());
+            Future<?> completion = executor.submit(() -> {
+                finalizerReady.countDown();
+                try {
+                    assertTrue(releaseFinalizer.await(5L, TimeUnit.SECONDS));
+                } catch (InterruptedException exception) {
+                    Thread.currentThread().interrupt();
+                    throw new AssertionError(exception);
+                }
+                fixture.finalizer.get().run();
+            });
+            assertTrue(finalizerReady.await(5L, TimeUnit.SECONDS));
+            assertEquals(0, fixture.observer.notifications.get());
+            assertTrue(fixture.parallel.cancel());
+            fixture.inner.setPostProcessor(mock(IBatchProcessor.class));
+            releaseFinalizer.countDown();
+            completion.get(5L, TimeUnit.SECONDS);
+            assertEquals(1, fixture.block.get());
+            assertEquals(1, fixture.observer.notifications.get());
+            assertEquals(1, fixture.observer.completed.get());
+            fixture.finalizer.get().run();
+            assertEquals(1, fixture.observer.notifications.get());
+            assertEquals(1, fixture.observer.completed.get());
+        } finally {
+            releaseFinalizer.countDown();
+            executor.shutdownNow();
+        }
+    }
+
+    @Test
+    void cancelledBeforeAdmissionDoesNotApplyOrNotify() {
+        Fixture fixture = new Fixture();
+        assertTrue(fixture.parallel.cancel());
+        assertThrows(RuntimeException.class, () -> fixture.chunk.call(fixture.owner, fixture.set, () -> { }));
+        assertEquals(0, fixture.block.get());
+        assertEquals(0, fixture.observer.notifications.get());
+        verify(fixture.get, never()).call(any(), any(), any());
+    }
+
+    @Test
+    void observerOnlyApplicationDoesNotRequestOrReadBeforeStateCopy() {
+        Fixture fixture = new Fixture();
+        fixture.chunk.call(fixture.owner, fixture.set, () -> { });
+        fixture.finalizer.get().run();
+        verify(fixture.get).setCreateCopy(false);
+        verify(fixture.get, never()).getCopy(anyInt());
+        assertEquals(1, fixture.observer.notifications.get());
+    }
+
+    @Test
+    void historyKeepsBeforeStateWhileObserverSharesAppliedCompletion() {
+        Fixture fixture = new Fixture();
+        IChunkGet before = mock(IChunkGet.class);
+        IBatchProcessor history = mock(IBatchProcessor.class);
+        when(history.getScope()).thenReturn(ProcessorScope.READING_BLOCKS);
+        when(history.requiresBeforeState()).thenCallRealMethod();
+        when(history.capturePostProcessor(any())).thenCallRealMethod();
+        fixture.inner.setPostProcessor(MultiBatchProcessor.of(history, fixture.observer));
+        when(fixture.get.getCopy(7)).thenReturn(before);
+        fixture.chunk.call(fixture.owner, fixture.set, () -> { });
+        fixture.finalizer.get().run();
+        verify(fixture.get).setCreateCopy(true);
+        verify(history).postProcess(fixture.chunk, before, fixture.set);
+        assertEquals(1, fixture.observer.notifications.get());
+    }
+
+    @Test
+    void nullPreprocessedSetNeverReachesNativeApplication() {
+        Fixture fixture = new Fixture();
+        when(fixture.owner.processSet(any(), any(), any())).thenReturn(null);
+        AtomicInteger recycled = new AtomicInteger();
+        fixture.chunk.call(fixture.owner, fixture.set, recycled::incrementAndGet);
+        assertEquals(1, recycled.get());
+        assertEquals(0, fixture.block.get());
+        assertEquals(0, fixture.observer.notifications.get());
+        verify(fixture.get, never()).call(any(), any(), any());
+    }
+
+    @Test
+    void admissionUsesReplacementSetAndReleasesApplication() {
+        Fixture fixture = new Fixture();
+        IChunkSet replacement = mock(IChunkSet.class);
+        when(fixture.owner.processSet(any(), any(), any())).thenReturn(replacement);
+        fixture.chunk.call(fixture.owner, fixture.set, () -> { });
+        fixture.finalizer.get().run();
+        verify(fixture.get).call(fixture.owner, replacement, fixture.finalizer.get());
+        assertSame(replacement, fixture.observer.appliedSet.get());
+        assertEquals(1, fixture.observer.completed.get());
+    }
+
+    @Test
+    void observerFailureStillRecyclesChunkAndReleasesApplication() {
+        Fixture fixture = new Fixture();
+        fixture.observer.failure = new IllegalStateException("Observer failed");
+        AtomicInteger recycled = new AtomicInteger();
+        fixture.chunk.call(fixture.owner, fixture.set, recycled::incrementAndGet);
+        assertThrows(IllegalStateException.class, () -> fixture.finalizer.get().run());
+        assertEquals(1, recycled.get());
+        assertEquals(1, fixture.observer.completed.get());
+    }
