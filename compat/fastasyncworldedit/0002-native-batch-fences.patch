+package com.fastasyncworldedit.core.util.task;
+
+import org.junit.jupiter.api.Test;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.Future;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicInteger;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertSame;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class DetachedNativeBatchQueueTest {
+    @Test
+    void emptyTailFenceAppliesAllDetachedBatchesBeforeNotification() throws Exception {
+        DetachedNativeBatchQueue batches = new DetachedNativeBatchQueue();
+        AtomicInteger blocks = new AtomicInteger();
+        List<Integer> notifications = new ArrayList<>();
+        Runnable detached = batches.admit(() -> {
+            blocks.addAndGet(1024);
+            notifications.add(blocks.get());
+        });
+        CountDownLatch workerReady = new CountDownLatch(1);
+        CountDownLatch releaseWorker = new CountDownLatch(1);
+        ExecutorService executor = Executors.newSingleThreadExecutor();
+        try {
+            Future<?> deferred = executor.submit(() -> {
+                workerReady.countDown();
+                try {
+                    assertTrue(releaseWorker.await(5L, TimeUnit.SECONDS));
+                } catch (InterruptedException exception) {
+                    Thread.currentThread().interrupt();
+                    throw new AssertionError(exception);
+                }
+                detached.run();
+            });
+            assertTrue(workerReady.await(5L, TimeUnit.SECONDS));
+            assertEquals(0, blocks.get());
+            batches.fence().run();
+            assertEquals(1024, blocks.get());
+            assertEquals(List.of(1024), notifications);
+            releaseWorker.countDown();
+            deferred.get(5L, TimeUnit.SECONDS);
+            assertEquals(1024, blocks.get());
+            assertEquals(List.of(1024), notifications);
+        } finally {
+            releaseWorker.countDown();
+            executor.shutdownNow();
+        }
+    }
+
+    @Test
+    void reverselyScheduledBatchesAndTailKeepAdmissionOrderAndApplyOnlyOnce() {
+        DetachedNativeBatchQueue batches = new DetachedNativeBatchQueue();
+        List<Integer> applied = new ArrayList<>();
+        Runnable first = batches.admit(() -> applied.add(1024));
+        Runnable second = batches.admit(() -> applied.add(2048));
+        batches.admit(() -> applied.add(2049));
+        second.run();
+        assertEquals(List.of(1024, 2048), applied);
+        batches.fence().run();
+        first.run();
+        second.run();
+        assertEquals(List.of(1024, 2048, 2049), applied);
+    }
+
+    @Test
+    void failedApplicationCannotMakeAFutureFenceSucceed() {
+        DetachedNativeBatchQueue batches = new DetachedNativeBatchQueue();
+        IllegalStateException failure = new IllegalStateException("Native write failed");
+        batches.admit(() -> { throw failure; });
+        assertSame(failure, assertThrows(IllegalStateException.class, () -> batches.fence().run()));
+        AtomicInteger next = new AtomicInteger();
+        batches.admit(next::incrementAndGet);
+        assertSame(failure, assertThrows(IllegalStateException.class, () -> batches.fence().run()));
+        assertEquals(0, next.get());
+    }
+
+    @Test
+    void applicationErrorRemainsVisibleToEveryLaterFence() {
+        DetachedNativeBatchQueue batches = new DetachedNativeBatchQueue();
+        AssertionError failure = new AssertionError("Native application failed");
+        batches.admit(() -> { throw failure; });
+        assertSame(failure, assertThrows(AssertionError.class, () -> batches.fence().run()));
+        assertSame(failure, assertThrows(AssertionError.class, () -> batches.fence().run()));
+    }
+
+    @Test
+    void actualSynchronousMutationStillNotifiesWhenLaterMetadataStepFails() {
+        AtomicInteger blocks = new AtomicInteger();
