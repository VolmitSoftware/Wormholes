@@ -0,0 +1,59 @@
+package com.fastasyncworldedit.core.util.task;
+
+import java.util.ArrayDeque;
+import java.util.Deque;
+import java.util.Objects;
+import java.util.concurrent.locks.ReentrantLock;
+
+public final class DetachedNativeBatchQueue {
+    private final Deque<Batch> pending = new ArrayDeque<>();
+    private final ReentrantLock applying = new ReentrantLock();
+    private long admitted;
+    private Throwable failure;
+
+    public synchronized Runnable admit(Runnable application) {
+        long sequence = ++admitted;
+        pending.addLast(new Batch(sequence, Objects.requireNonNull(application)));
+        return () -> applyThrough(sequence);
+    }
+
+    public synchronized Runnable fence() {
+        long sequence = admitted;
+        return () -> applyThrough(sequence);
+    }
+
+    private void applyThrough(long sequence) {
+        applying.lock();
+        try {
+            Batch batch;
+            while ((batch = takeThrough(sequence)) != null) {
+                try {
+                    batch.application().run();
+                } catch (RuntimeException | Error exception) {
+                    synchronized (this) {
+                        failure = exception;
+                    }
+                    throw exception;
+                }
+            }
+        } finally {
+            applying.unlock();
+        }
+    }
+
+    private synchronized Batch takeThrough(long sequence) {
+        if (failure instanceof RuntimeException exception) {
+            throw exception;
+        }
+        if (failure instanceof Error error) {
+            throw error;
+        }
+        if (pending.isEmpty() || pending.getFirst().sequence() > sequence) {
+            return null;
+        }
+        return pending.removeFirst();
+    }
+
+    private record Batch(long sequence, Runnable application) {
+    }
+}
diff --git a/worldedit-core/src/main/java/com/fastasyncworldedit/core/util/task/NativeChangeScope.java b/worldedit-core/src/main/java/com/fastasyncworldedit/core/util/task/NativeChangeScope.java
--- /dev/null
+++ b/worldedit-core/src/main/java/com/fastasyncworldedit/core/util/task/NativeChangeScope.java
@@ -0,0 +1,105 @@
+package com.fastasyncworldedit.core.util.task;
+
+import java.util.Objects;
+
+public final class NativeChangeScope implements AutoCloseable {
+    private static final ThreadLocal<NativeChangeScope> CURRENT = new ThreadLocal<>();
+
+    private final NativeChangeScope parent;
+    private final Runnable applied;
+    private final Runnable finished;
+    private boolean deferred;
+    private boolean returned;
+    private boolean applicationKnown;
+    private boolean changed;
+    private boolean synchronousChanged;
+    private boolean completed;
+
+    private NativeChangeScope(Runnable applied, Runnable finished) {
+        this.parent = CURRENT.get();
+        this.applied = Objects.requireNonNull(applied);
+        this.finished = Objects.requireNonNull(finished);
+        CURRENT.set(this);
+    }
+
+    public static NativeChangeScope open(Runnable applied, Runnable finished) {
+        return new NativeChangeScope(applied, finished);
+    }
+
+    public static NativeChangeScope capture() {
+        NativeChangeScope scope = CURRENT.get();
+        if (scope != null) {
+            synchronized (scope) {
+                scope.deferred = true;
+            }
+        }
+        return scope;
+    }
+
+    public static <T> T recordChange(T previous) {
+        NativeChangeScope scope = CURRENT.get();
+        if (scope != null && previous != null) {
+            synchronized (scope) {
+                scope.synchronousChanged = true;
+            }
+        }
+        return previous;
+    }
+
+    public void complete(boolean changed) {
+        boolean successful;
+        synchronized (this) {
+            if (deferred) {
+                return;
+            }
+            successful = changed || synchronousChanged;
+        }
+        applied(successful);
+    }
+
+    public void applied(boolean changed) {
+        synchronized (this) {
+            if (applicationKnown) {
+                return;
+            }
+            applicationKnown = true;
+            this.changed = changed;
+        }
+        publishIfReady();
+    }
+
+    @Override
+    public void close() {
+        if (CURRENT.get() != this) {
+            throw new IllegalStateException("Native change scopes closed out of order");
+        }
+        if (parent == null) {
+            CURRENT.remove();
+        } else {
+            CURRENT.set(parent);
+        }
+        synchronized (this) {
+            returned = true;
+        }
+        complete(false);
+        publishIfReady();
+    }
+
+    private void publishIfReady() {
+        boolean notify;
+        synchronized (this) {
+            if (completed || !applicationKnown || deferred && !returned) {
+                return;
+            }
+            completed = true;
+            notify = changed;
+        }
+        try {
+            if (notify) {
+                applied.run();
+            }
+        } finally {
+            finished.run();
+        }
+    }
+}
